#Docker subnet
LOCAL_SUBNET=10.255.255.128/25
PROMETHEUS_EXPOSE=127.0.0.1:9090

#System configuration
NGINX_EXPOSE=0.0.0.0:8088
MYSQL_EXPOSE=127.0.0.1:33306
MYSQL_INNODB_BUFFER_POOL_SIZE=1G
MYSQL_KEY_BUFFER_SIZE=256M
MYSQL_TABLE_OPEN_CACHE=500


DATABASE_URL=mysql:host=wca-db;dbname=support;charset=utf8
DATABASE_NAME=support
DATABASE_USER=root
# Choose your own; never commit the real one (tools/secret_scan.py refuses it).
DATABASE_PASSWD=change-me

APP_NAME="Support DMS"
API_BASE_PATH=/api/v1
IMAGE_BASE_URL=/upload/icons

# Panel configuration
# Variants: ru, en, ua
DEFAULT_LANGUAGE=en
LOGS_RETURN_RESULTS_LIMIT=500
MAP_COORDINATES=50.4431,30.5168

#Variants: DEBUG,INFO,NOTICE,WARNING,ERROR,CRITICAL,ALERT,EMERGENCY
#For details - see \Monolog\Logger constrants
LOG_LEVEL=WARNING
LOG_FILES_PATH=/log

#API configuration
#strict rules restrict methods without setted permissions
API_STRICT_RULES=yes
#time in seconds for live user sessions
API_KEY_EXPIRATION=864000

#change to PRODUCTION in production envinronment
ENVIRONMENT=PRODUCTION

#Trusted ip configuration
#List of networks or host
TRUSTED_HOST_NETWORK_LIST=
#By default server use REMOTE_ADDR for get client IP address. If you use proxy - you can set proxy_enabled=yes
PROXY_ENABLED=no
#Name of header with real client IP
PROXY_REAL_IP_HEADER=X-Forwarded-For

# MEMCACHE CONFIGURATION
MEMCACHE_ENABLED=yes
MEMCACHE_SERVER=wca-memcached
MEMCACHE_PORT=11211
MEMCACHE_CACHING_QUERY_TIMEOUT_SEC=30

REDIS_ENABLED=yes
REDIS_HOST=wca-redis
REDIS_PORT=6379
REDIS_PASSWORD=
PROMETHEUS_URL=http://wca-prometheus:9090/prometheus
ALERTMANAGER_URL=http://wca-alertmanager:9093/alertmanager
PROMETHEUS_RETENTION_TIME=30d

# Device connection configuration
RR_NUM_WORKERS=50
RR_MAX_WORKER_MEMORY=160
SWC_CONSOLE_CONN_TYPE='telnet'
SWC_CONSOLE_PORT='23'
SWC_CONSOLE_TIMEOUT_SEC='300'
SWC_SNMP_REPEATS=3
SWC_SNMP_TIMEOUT_SEC=4
SWC_CALL_CONCURRENCY=1
SWC_MIKROTIK_API_PORT=8728
SWC_CACHE_SYSTEM=memcache
SWC_CACHE_ACTUALIZE_TIMEOUT_SEC=3600
SWC_CACHE_TIMEOUT_SEC=86400
SWC_URL_PATH=http://wca-nginx/api/switcher-core
SWC_SNMP_PORT=161
SWC_SNMP_VERSION=2c
SWC_CONSOLE_WAIT_BYTE_SEC='5'

POLLER_IGNORE_DOWN=yes
POLLER_COUNT_PROCS=10
POLLER_DO_NOT_CLEAR_INTERFACES=no

SWC_IGNORE_ICMP_PING=yes
LOG_ALL_EVENTS=no

RATE_LIMITER_ENABLED=yes
RATE_LIMITER_TIME=3600
RATE_LIMITER_ATTEMPTS=3
SECURE_CHECK_PASSWORD_STRENGTH=yes
SECURE_ENCRYPT_ACCESSES=no

# Disable calculate interface statistic on device dashboard for all devices. Please, use it if your device list loading very slow
DEVICES_LIST_DISABLE_IFACE_STAT=no

# SNMP trap service control
TRAP_SERVICE_ENABLED=yes
TRAP_SERVICE_SNMP_PORT=162
TRAP_SERVICE_COUNT_HANDLERS=10
TRAP_SERVICE_IGNORE_UNKNOWN_TRAPS=no

SEARCH2_ENABLED=no
SEARCH2_FILTER=agreement
MAP_TILE_LAYER='Google (street)'

# Supervisor RPC on the schedule-executor container. Defaults below match the
# supervisord config shipped in docker/schedule-executor - change both together.
SUPERVISOR_RPC_URL=http://wca-schedule-executor:9001/RPC2
SUPERVISOR_RPC_USER=user
SUPERVISOR_RPC_PASSWORD=user

# Grafana admin account. Leave unset and docker-compose falls back to admin/admin,
# which is reachable through the /grafana route - set a real password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=