# Copy to cybersathy.env in the repository root and fill in. cybersathy.env is never committed.
# Use only URL-safe characters in passwords (letters, digits, - _ . ~): the Redis password is placed inside a URL.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"

CYBERSATHY_POSTGRES_PASSWORD=
CYBERSATHY_REDIS_PASSWORD=

# Signs every job on the queue so a worker acts only on jobs the API produced. At least 32 random characters.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CYBERSATHY_JOB_SIGNING_KEY=

# development | production. Production makes the session cookie Secure and refuses weak seed passwords.
CYBERSATHY_ENVIRONMENT=development
CYBERSATHY_NGINX_EXPOSE=8080

# First administrator. Leave the password empty to have one generated: it is printed once in the init container log
# and the account must change it at first login.
CYBERSATHY_SEED_ADMIN_USERNAME=admin
CYBERSATHY_SEED_ADMIN_EMAIL=
CYBERSATHY_SEED_ADMIN_PASSWORD=

# Encryption of device credentials and two-factor secrets. Format  key_id:base64key  (comma-separated for rotation).
# Generate a key with:  docker compose --env-file cybersathy.env -f docker-compose.cybersathy.yml run --rm cybersathy-init python -m app.cli crypto generate-key
# Keep this value out of database backups and store it separately.
CYBERSATHY_ENCRYPTION_KEYS=
CYBERSATHY_ENCRYPTION_ACTIVE_KEY_ID=

# Optional: comma-separated CIDRs. When set, a device's management address must fall inside one of them.
CYBERSATHY_MANAGEMENT_NETWORKS=
