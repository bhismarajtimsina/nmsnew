#Docker subnet
LOCAL_SUBNET=10.255.255.128/25
PROMETHEUS_EXPOSE=127.0.0.1:9090
NETFLOW_EXPOSE=0.0.0.0:2055
SFLOW_EXPOSE=0.0.0.0:6343

#System configuration
NGINX_EXPOSE=0.0.0.0:8088
MYSQL_EXPOSE=127.0.0.1:33306
MYSQL_INNODB_BUFFER_POOL_SIZE=1G
MYSQL_KEY_BUFFER_SIZE=256M
MYSQL_TABLE_OPEN_CACHE=500


DATABASE_URL=mysql:host=wca-db;dbname=support;charset=utf8
DATABASE_NAME=support
DATABASE_USER=root
DATABASE_PASSWD=superpassword

APP_NAME='Support'
API_BASE_PATH=/api/v1
IMAGE_BASE_URL=/upload/icons

# Panel configuration
# Variants: ru, en, ua
DEFAULT_LANGUAGE='en'
LOGS_RETURN_RESULTS_LIMIT='500'
MAP_COORDINATES='27.7007,85.3001'

#Variants: DEBUG,INFO,NOTICE,WARNING,ERROR,CRITICAL,ALERT,EMERGENCY
#For details - see \Monolog\Logger constrants
LOG_LEVEL='WARNING'
LOG_FILES_PATH=/log

#API configuration
#strict rules restrict methods without setted permissions
API_STRICT_RULES=yes
#time in seconds for live user sessions
API_KEY_EXPIRATION='864000'

#change to PRODUCTION in production envinronment
ENVIRONMENT=PRODUCTION

#Trusted ip configuration
#List of networks or host
TRUSTED_HOST_NETWORK_LIST='0.0.0.0/0'
#By default server use REMOTE_ADDR for get client IP address. If you use proxy - you can set proxy_enabled=yes
PROXY_ENABLED=''
#Name of header with real client IP
PROXY_REAL_IP_HEADER='X-Forwarded-For'

# MEMCACHE CONFIGURATION
MEMCACHE_ENABLED=yes
MEMCACHE_SERVER=wca-memcached
MEMCACHE_PORT=11211
MEMCACHE_CACHING_QUERY_TIMEOUT_SEC=30

REDIS_ENABLED=yes
REDIS_HOST=wca-redis
REDIS_PORT=6379
REDIS_PASSWORD=
PROMETHEUS_URL=http://wca-prometheus:9090/prometheus
ALERTMANAGER_URL=http://wca-alertmanager:9093/alertmanager
PROMETHEUS_RETENTION_TIME='30d'

# Device connection configuration
RR_NUM_WORKERS='50'
RR_MAX_WORKER_MEMORY=160
SWC_CONSOLE_CONN_TYPE='telnet'
SWC_CONSOLE_PORT='23'
SWC_CONSOLE_TIMEOUT_SEC='300'
SWC_SNMP_REPEATS='3'
SWC_SNMP_TIMEOUT_SEC='4'
SWC_CALL_CONCURRENCY=1
SWC_MIKROTIK_API_PORT='8728'
SWC_CACHE_SYSTEM=memcache
SWC_CACHE_ACTUALIZE_TIMEOUT_SEC='43200'
SWC_CACHE_TIMEOUT_SEC=86400
SWC_URL_PATH=http://wca-nginx/api/switcher-core
SWC_SNMP_PORT='161'
SWC_SNMP_VERSION='2c'
SWC_CONSOLE_WAIT_BYTE_SEC='5'

POLLER_IGNORE_DOWN='1'
POLLER_COUNT_PROCS='10'
POLLER_DO_NOT_CLEAR_INTERFACES=''

SWC_IGNORE_ICMP_PING=yes
LOG_ALL_EVENTS=no

RATE_LIMITER_ENABLED=''
RATE_LIMITER_TIME='1'
RATE_LIMITER_ATTEMPTS='3'
SECURE_CHECK_PASSWORD_STRENGTH='1'
SECURE_ENCRYPT_ACCESSES='yes'

# Disable calculate interface statistic on device dashboard for all devices. Please, use it if your device list loading very slow
DEVICES_LIST_DISABLE_IFACE_STAT=no

# SNMP trap service control
TRAP_SERVICE_ENABLED='1'
TRAP_SERVICE_SNMP_PORT='1162'
TRAP_SERVICE_COUNT_HANDLERS='10'
TRAP_SERVICE_IGNORE_UNKNOWN_TRAPS=''

SEARCH2_ENABLED=''
SEARCH2_FILTER='agreement'
MAP_TILE_LAYER='OpenStreetMap'

EXTERNAL_HTTP_ADDRESS='http://192.168.137.133:8088'
WEB_ZOOM_MAIN='0'
WEB_ZOOM_IFRAME='1'
SWC_CHECK_ICMP_PING='1'
SWC_ENABLE_SPLITTING='1'
ANALYTICS_IGNORE_IFACES_WITH_MORE_THAN='10'
ANALYTICS_SHOW_ACTIVE_MORE_THAN='1800'
ANALYTICS_MIN_RX_SIGNAL='-28'
ANALYTICS_MAX_RX_SIGNAL='-10'
ANALYTICS_MIN_OLT_RX_SIGNAL='-28'
ANALYTICS_MAX_OLT_RX_SIGNAL='-10'
ANALYTICS_MIN_SFP_RX_SIGNAL='-15'
ANALYTICS_MAX_SFP_RX_SIGNAL='5'
AUTO_TOPOLOGY_SCHEDULE_ENABLED='1'
AUTO_TOPOLOGY_THREADS='10'
LINKS_UTILIZATION_CALCULATE_PERIOD='15m'
LINKS_UTILIZATION_MAX_PRC_FOR_ALERT='85'
NOTIFICATIONS_CHECK_PREVIOUS_MESSAGE=''
OXIDIZED_URL='http://wca-oxidized:8888/oxidized'
OXIDIZED_THREADS='30'
OXIDIZED_INTERVAL='86400'
OXIDIZED_TIMEOUT='300'

SEARCH_DEVICE_SOURCES='history,device'
SEARCH_DEVICE_CHECK_ALL_SOURCES=''
SEARCH_DEVICE_HISTORY_ONLY_ACTIVE='1'
SEARCH_DEVICE_IGNORE_TAG_PORTS='1'
SEARCH_DEVICE_REQUEST_CONCURRENCY='50'
TRAP_SERVICE_CHECK_COMMUNITY=''
USERSIDE_WEB_ADDRESS='https://billing.org'
USERSIDE_API_KEY=''
USERSIDE_SYNC_DATA='["devices"]'
USERSIDE_ADD_NEW_DEVICES_TO_GROUP_ID='-1'
USERSIDE_DELETE_NOT_EXISTED_DEVICES=''
USERSIDE_UPDATE_DEVICES_FIELDS='["coordinates","name","location","comment"]'

CONSOLE_ENABLE_WEB='1'
CONSOLE_OPEN_AT='tab'
CONSOLE_FONT_SIZE='14'
MIKBILL_API_ADDR=''
MIKBILL_AUTH_KEY=''
MIKBILL_GLOBAL_SEARCH_FIELD='agreement'
MIKBILL_SET_ONT_COORDINATES=''
NODENY_URL=''
NODENY_DATABASE_DSN=''
NODENY_DATABASE_USERNAME=''
NODENY_DATABASE_PASSWORD=''
NODENY_COMPARISON_DESCRIPTION_REQUIRED=''
NODENY_COMPARISON_CHECK_TOPOLOGY=''

PATHS_DEGRADED_LATENCY_MS='150'
PATHS_STATE_METRIC_TTL_SEC='300'
