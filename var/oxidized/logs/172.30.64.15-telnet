!!slot end
!
interface VLAN30
 ip address 10.0.0.3 255.255.255.0
 no ip directed-broadcast
!
interface VLAN50
 ip address dhcp
 no ip directed-broadcast
!
interface VLAN300
 ip address dhcp
 no ip directed-broadcast
!
interface VLAN301
 no ip address
 no ip directed-broadcast
!
interface VLAN1555
 ip address 172.30.64.15 255.255.255.0
 no ip directed-broadcast
!
interface VLAN2000
 ip address 10.10.64.15 255.255.255.0
 no ip directed-broadcast
!
!
!
vlan 1,50,52-53,55,100,205,250-251,300-303,567,601,678,883,1437,1444,1555-1556,1607
vlan 2000
!
!
!
!
!
ip dhcp-relay snooping vlan  100,567,601
!
!
!
!
!
!
!
ip route default 172.30.64.1 
ip exf
!
ipv6 exf
!
ip telnet attack-defense
ip telnet enable
!
ip http language english
ip http server
no ip http web first-login-reset-password
!
!
snmp-server community 0 KNOLT RW 
snmp-server community 0 pathari_ro RO 
snmp-server community 0 pathari_rw RW 
!
