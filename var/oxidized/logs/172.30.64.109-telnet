 dba-profile add profile-id 20 profile-name "FTTH" type4 max 1000000
 ont tr069-server-profile add profile-id 2 profile-name "tr069-server-profile_2" url "http://konnect-acs.vianet.com.np:7547" user "konnectacs" "%#%#e]*`AjU_L'J%riS]PMaEK:kYT9-m-KFc_mS4W{<IKzu`ApErs,KTKL3,'S6F%#%#"
 ont-srvprofile gpon profile-id 20 profile-name "FTTH"
  ont-port pots adaptive 32 eth adaptive 8 
  commit
 ont-lineprofile gpon profile-id 0 profile-name "line-profile_default_0"
  tcont 0 dba-profile-id 2
  tcont 1 dba-profile-id 0
  commit
  quit
 ont-lineprofile gpon profile-id 20 profile-name "FTTH"
  tr069-management enable
  tcont 4 dba-profile-id 20
  gem add 4 eth tcont 4
  gem add 5 eth tcont 4
  gem mapping 4 0 vlan 100
  gem mapping 5 0 vlan 883
  commit
  quit
